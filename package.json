{
  "name": "photostat-master-desktop",
  "version": "1.0.0",
  "description": "Photostat Master — Desktop PDF viewer, converter & image maker",
  "author": "The Master Sahib",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder --win --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "firebase": "10.14.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.7.76",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.2",
    "concurrently": "9.0.1",
    "cross-env": "7.0.3",
    "electron": "32.2.0",
    "electron-builder": "25.1.8",
    "vite": "5.4.9",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.themastersahib.photostat.desktop",
    "productName": "Photostat Master",
    "directories": { "output": "release" },
    "files": [ "dist/**/*", "electron/**/*" ],
    "win": {
      "target": [ { "target": "nsis", "arch": [ "x64" ] } ],
      "icon": "build/icon.ico",
      "artifactName": "Photostat-Master-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Photostat Master"
    }
  }
}
